# systemd unit for guardd — Sensitive Data Firewall daemon (Linux V1)
#
# Install:   sudo deploy/install.sh
# Uninstall: sudo deploy/install.sh --uninstall
#
# Why root: fanotify permission-event enforcement (FAN_CLASS_CONTENT +
# FAN_OPEN_PERM) requires CAP_SYS_ADMIN. A capability-less mode cannot
# intercept opens; do not pretend otherwise. The daemon runs as root and
# resolves process identity via /proc regardless of the target process's UID.
#
# Fail-open note: if guardd crashes, the fanotify group fd closes and all
# marks are removed. Files become unprotected until the daemon restarts.
# Restart=always with RestartSec=2 minimizes (but does not eliminate) the
# window. See docs/SECURITY_MODEL.md §Fail-open on daemon close.
[Unit]
Description=Sensitive Data Firewall daemon (guardd)
After=local-fs.target
Before=graphical.target
DefaultDependencies=yes
# A missing configuration means there is no reviewed resource set to protect.
# Do not restart-loop a daemon that cannot enforce anything; `guardctl setup`
# creates this file explicitly before the operator enables the service.
ConditionPathExists=/etc/guardd/config.json

[Service]
Type=simple
# `@GUARDD_BINDIR@` is substituted at install/package build time.  The
# repository carries one security-reviewed unit; source installs use
# /usr/local/bin and distribution packages use /usr/bin.
ExecStart=@GUARDD_BINDIR@/guardd --enforce-browser-config /etc/guardd/config.json --ipc-socket /run/guardd/guardd.sock --audit-db /var/lib/guardd/audit.db
Restart=always
RestartSec=2
# Give the daemon 10s to start; if it fails to initialize, systemd restarts it.
TimeoutStartSec=10
# Graceful shutdown: SIGTERM, then SIGKILL after 5s.
KillSignal=SIGTERM
TimeoutStopSec=5
KillMode=control-group

# Run as root (fanotify FAN_CLASS_CONTENT requires CAP_SYS_ADMIN).
User=root
# The socket inherits this group. Sensitive mutation requests still require
# polkit; group membership only grants transport access/read-only own-UID APIs.
Group=guardd-users

# State + runtime directories (systemd creates these with correct perms).
StateDirectory=guardd
StateDirectoryMode=0700
RuntimeDirectory=guardd
RuntimeDirectoryMode=0750
LogsDirectory=guardd

# Environment: minimal, no network proxy tricks.
Environment=RUST_LOG=info
Environment=GUARDD_CONFIG=/etc/guardd/config.json

# Security hardening (do NOT use mount-namespace isolation — it would hide
# real user profiles from fanotify, breaking enforcement).
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false
# SSH_AUTH_SOCK commonly lives under /tmp/ssh-*/agent.*. A private /tmp would
# hide that kernel endpoint from guardd and make authoritative agent identity
# verification impossible. guardd never treats pathname contents as trusted;
# it connects, checks SO_PEERCRED, verifies /proc identity, and pins the socket
# inode behind a root-controlled hardlink before authorizing ssh-add.
PrivateTmp=false
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# Capabilities: CAP_SYS_ADMIN gates fanotify permission events;
# CAP_SYS_PTRACE is required by ptrace_may_access to resolve /proc/<pid>/exe
# for another UID on hardened kernels; CAP_DAC_READ_SEARCH reads protected
# metadata, CAP_DAC_OVERRIDE connects to an owner-only ssh-agent socket,
# CAP_FOWNER pins that verified user-owned socket inode behind a root-controlled
# hardlink despite fs.protected_hardlinks, and CAP_KILL supports broker child
# validation/cleanup.
# No ambient capabilities are needed while the service runs as uid 0.
AmbientCapabilities=
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_KILL CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER

# Resource limits: the daemon is lightweight but handle burst load.
LimitNOFILE=4096
MemoryMax=256M

# Standard I/O: log to journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=guardd

[Install]
WantedBy=multi-user.target
