[Unit]
Description=Sensitive Data Firewall desktop notifications
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Substituted at install/package build time; see deploy/guardd.service.
ExecStart=@GUARDD_BINDIR@/guard-notify
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# `ProtectHome=true` hides the desktop session's home-backed notification
# resources on common Wayland desktops and makes notify-send fail to connect.
# Read-only still prevents the notifier from changing profile data while
# preserving the session integration it needs to present a denial.
ProtectHome=read-only

[Install]
WantedBy=default.target
